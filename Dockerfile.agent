# syntax=docker/dockerfile:1

# --- Base Stage: Install system dependencies ---
FROM node:26-trixie-slim@sha256:ffc78385a788964bb3cbab5e434ff79a10bdc25b8ae6db03fe5fe6cb14053c09 AS base

ENV NODE_ENV=production
ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_LOGLEVEL=warn
ENV HOME=/home/node

RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    build-essential \
    python3 \
    python3-dev \
    git \
    gh \
    fd-find \
    ripgrep \
    tmux \
    && ln -s /usr/bin/fdfind /usr/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# --- Release Stage: Setup application and workspace ---
FROM base AS release

# Install the agent globally
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.80.10

# Create required directories and ensure correct ownership for the unprivileged user
RUN mkdir -p /home/node/.pi/agent \
    /workspace \
    /home/node/.config \
    /home/node/.npm \
    /shared \
    && chown -R node:node /home/node/.pi \
    /workspace \
    /home/node/.config \
    /home/node/.npm \
    /shared

# Copy the entrypoint script and make it executable
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

# Switch to the unprivileged node user for execution
USER node

ENTRYPOINT ["pi"]
CMD []

