# ==============================================================================
# Pi Coding Agent - Docker Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and modify it to match your system settings.
# Run: cp .env.example .env
# ==============================================================================

# Active configuration profile (e.g., 'gemma-12b-gpu', 'gemma-12b-cpu', 'qwen-27b-gpu').
# Profiles are stored in the 'profiles/' directory.
# Leave blank to use the default .env configuration variables below.
ACTIVE_PROFILE=

# ------------------------------------------------------------------------------
# 1. Host Permissions & Execution Control (Linux/macOS)
# ------------------------------------------------------------------------------
# Set user ID (UID) and group ID (GID) mapping to match files on the host machine.
# This prevents permissions errors for mounted workspace folders.
# On Linux, obtain these values by running: `id -u` and `id -g`
HOST_UID=1000
HOST_GID=1000

# ------------------------------------------------------------------------------
# 2. Git Configurations
# ------------------------------------------------------------------------------
# The coding agent makes Git commits in your workspace. Fill these out so commits
# are correctly signed and attributed to your identity.
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="your.email@example.com"
GIT_COMMITTER_NAME="Your Name"
GIT_COMMITTER_EMAIL="your.email@example.com"

# ------------------------------------------------------------------------------
# 3. Web Portal Configuration
# ------------------------------------------------------------------------------
# Password for the web portal session. The username is fixed to 'pi'.
# The portal will refuse to start if this is left empty or unset.
PORTAL_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Local Model Runner Configuration (llama.cpp server)
# ------------------------------------------------------------------------------
# Runner image: Use ':server-cuda' for NVIDIA GPUs, or ':server' for CPU-only.
# Default is loaded from pinned-versions.env; uncomment and edit to override.
# MODEL_RUNNER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:93b36c099c8fc978b79fec5a09dedf6573e5e3cef4f2223453dad93e6a273305

# Model file name stored inside the host './models' directory.
MODEL_FILE=Qwen3.6-27B-MTP-GGUF-UD-Q4_K_XL.gguf

# Number of layers to offload to the GPU (set to 0 for CPU-only).
GPU_LAYERS=99

# Model runner endpoint port (exposed to host)
MODEL_PORT=8080

# The port on your host where the external model server (or SSH tunnel) is listening
EXTERNAL_MODEL_PORT=8080

# Maximum context size the local inference engine will load (in tokens).
CTX_SIZE=32768

# Target GPU device index
CUDA_VISIBLE_DEVICES=0

# Additional llama.cpp options (e.g. Group Attention settings for Qwen)
# To secure the server when exposing the port, you can add an API key (e.g. --api-key secret_key):
LLAMA_ARG_THREADS=8
LLAMA_ARG_SPEC_TYPE=draft-mtp
LLAMA_ARG_SPEC_DRAFT_N_MAX=3
LLAMA_ARG_SPEC_DRAFT_MODEL=/models/mtp-gemma-4-E4B-it-Q8_0.gguf
LLAMA_ARG_CACHE_TYPE_K=q5_0
LLAMA_ARG_CACHE_TYPE_V=q4_0
LLAMA_ARG_CACHE_RAM=2048
LLAMA_ARG_CTX_CHECKPOINTS=2
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_BATCH=512
LLAMA_ARG_UBATCH=512
LLAMA_ARG_JINJA=true
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_FIT=on
LLAMA_ARG_FIT_TARGET=512
LLAMA_ARG_FIT_CTX=32768
LLAMA_ARG_REASONING=off

# Sampler parameters not available via direct environment variables
LLAMA_ARGS="--temp 1.0 --top_p 0.95 --top_k 64 --repeat-penalty 1.0"

# ------------------------------------------------------------------------------
# 5. Multi-Agent Orchestrator Configuration
# ------------------------------------------------------------------------------
# Maximum manager/worker iterations per multi-agent workflow run
MULTIAGENT_MAX_ITERS=10