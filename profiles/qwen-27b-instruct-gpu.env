MODEL_FILE=qwen3.6-27b-instruct-Q4_K_M.gguf
GPU_LAYERS=99
CTX_SIZE=32768
USE_GPU=true

# CPU Threads (Physical cores)
LLAMA_ARG_THREADS=12

# KV Cache Quantization (Reduces KV footprint by ~50%)
LLAMA_ARG_CACHE_TYPE_K=q4_0
LLAMA_ARG_CACHE_TYPE_V=q4_0

# Batch Processing Sizes (Prevents CUDA workspace allocation spikes)
LLAMA_ARG_BATCH=512
LLAMA_ARG_UBATCH=256

# Context Allocation Strategy (Hard capped for 24GB VRAM safety)
LLAMA_ARG_FIT=on
LLAMA_ARG_FIT_TARGET=512
LLAMA_ARG_FIT_CTX=32768

# Execution Flags
LLAMA_ARG_JINJA=true
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_CTX_CHECKPOINTS=2

# Bounded reasoning control (disable or constrain to prevent context bloat)
LLAMA_ARG_REASONING=off

# Creative Writing Sampler Parameters (Club 3090 tuned for Qwen continuity)
LLAMA_ARGS="--temp 0.7 --top_p 0.8 --top_k 20 --repeat-penalty 1.05"
