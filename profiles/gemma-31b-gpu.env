MODEL_FILE=gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
GPU_LAYERS=99
CTX_SIZE=16384
USE_GPU=true

# CPU Threads (Keep locked to physical cores for any partial offloading)
LLAMA_ARG_THREADS=12

# KV Cache Quantization (Downgraded to fit VRAM budget)
LLAMA_ARG_CACHE_TYPE_K=q4_0
LLAMA_ARG_CACHE_TYPE_V=q4_0

# Batch Processing Sizes
LLAMA_ARG_BATCH=1024
LLAMA_ARG_UBATCH=512

# Context Allocation Strategy (Hard capped to protect 24GB VRAM limit)
LLAMA_ARG_FIT=on
LLAMA_ARG_FIT_TARGET=512
LLAMA_ARG_FIT_CTX=16384

# Execution Flags
LLAMA_ARG_JINJA=true
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_CTX_CHECKPOINTS=2
LLAMA_ARG_REASONING=on

# Sampler parameters
LLAMA_ARGS="--temp 1.0 --top_p 0.95 --top_k 64 --repeat-penalty 1.0"
