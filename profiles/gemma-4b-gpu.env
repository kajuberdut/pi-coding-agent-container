MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
GPU_LAYERS=99
CTX_SIZE=16384
USE_GPU=true

# GPU Offloading / Threads
LLAMA_ARG_THREADS=8

# Execution Flags
LLAMA_ARG_JINJA=true
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_REASONING=on

# Optional: Speculative decoding (uncomment if you want to use the draft model)
# LLAMA_ARG_SPEC_TYPE=draft-mtp
# LLAMA_ARG_SPEC_DRAFT_N_MAX=2
# LLAMA_ARG_SPEC_DRAFT_MODEL=/models/mtp-gemma-4-E4B-it-Q8_0.gguf
# LLAMA_ARG_KV_UNIFIED=true
# LLAMA_ARG_CTX_CHECKPOINTS=2

# Sampler parameters
LLAMA_ARGS="--temp 1.0 --top_p 0.95 --top_k 64 --repeat-penalty 1.0"
